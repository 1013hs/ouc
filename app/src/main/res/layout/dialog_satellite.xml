<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F5FF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="卫星信号状态与位置图"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvSatCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前参与定位卫星数量: 0 颗"
        android:textSize="15sp"
        android:textColor="#555555"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <com.example.rockattitude.SkyplotView
        android:id="@+id/skyplotView"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#111111" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提示: 绿色代表参与定位，灰色代表未参与。外圈为仰角 0°，圆心为 90°。"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingTop="10dp"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
