<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="把手机背面贴在岩面上"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/tvStrike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="走向: --°"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvDip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="倾角: --°"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/tvDipDir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="倾向: --°"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存当前产状"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="水印相机"
        android:textSize="15sp"
        android:layout_marginTop="3dp" />

    <!-- 平均采样 + 卫星信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <Button
            android:id="@+id/btnAverage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="平均采样"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSatellite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="卫星信息"
            android:textSize="13sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 新增：导出KML + 导出CSV + 历史测量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <Button
            android:id="@+id/btnExportKml"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导出KML"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导出CSV"
            android:textSize="13sp"
            android:layout_marginStart="4dp" />
        
        <Button
            android:id="@+id/btnHistoryTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="历史轨迹"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
        
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="历史测量"
            android:textSize="13sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 轨迹预览 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实时轨迹预览"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp" />

    <com.example.rockattitude.TrackView
        android:id="@+id/trackView"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#F0F0F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnTrackToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始记录轨迹"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNavigate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导航"
            android:textSize="13sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNavInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:paddingTop="2dp"
        android:textColor="#D32F2F" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日保存记录"
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
