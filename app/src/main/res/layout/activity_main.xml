<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="把手机背面贴在岩面上"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvStrike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="走向: --°"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="倾角: --°"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tvDipDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="倾向: --°"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="6dp" />

        <!-- 新增：当前坐标与地点小窗口（可点击放大） -->
        <TextView
            android:id="@+id/tvCurrentCoord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="#333333"
            android:text="坐标获取中...\n点击可查看本次所有轨迹点"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存当前产状"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="水印相机"
            android:textSize="15sp"
            android:layout_marginTop="3dp" />

        <!-- 平均采样 + 卫星信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <Button
                android:id="@+id/btnAverage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="平均采样"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSatellite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="卫星信息"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 历史记录 + 坐标系 + 岩性 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <Button
                android:id="@+id/btnHistoryMain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="历史记录"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCoord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="坐标系"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnLithology"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="岩性"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 导出按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <Button
                android:id="@+id/btnExportKml"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出KML"
                android:textSize="13sp"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出CSV"
                android:textSize="13sp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#7B1FA2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 轨迹预览 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实时轨迹预览"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <com.example.rockattitude.TrackView
            android:id="@+id/trackView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/btnTrackToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始记录轨迹"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导航"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNavInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:paddingTop="2dp"
            android:textColor="#D32F2F" />

        <!-- 今日保存记录（只显示最新一条，点击放大） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今日保存记录（点击查看全部）"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tvLatestRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8F8F8"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="#333333"
            android:text="暂无记录"
            android:minHeight="60dp" />

        <!-- 版权声明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="此软件所有版权归1037HLY所有"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
